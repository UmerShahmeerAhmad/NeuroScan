# ---------------------------------------------------------------
# NeuroScan AI settings.
# Copy this file to ".env" (same folder) and edit the values.
# Never commit the real .env file: it holds your passwords.
# ---------------------------------------------------------------

# --- Database (create the database and user in pgAdmin first) ---
# If your password contains special characters, URL-encode them
# (for example "@" becomes "%40").
DATABASE_URL=postgresql://neuroscan_user:yourpassword@localhost:5432/neuroscan_db

# --- Security ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string-of-at-least-32-characters
# How long a login stays valid (minutes). 480 = 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Administrator account ---
# Created automatically the first time the app starts.
# Changing the password here later does NOT change an existing admin.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@neuroscan.com
ADMIN_PASSWORD=ChangeThisPassword1

# --- Model ---
# Path to your trained weights (relative to the project folder, or absolute).
MODEL_PATH=app/weights/model.pth

# MS-CBAM-Net checkpoints from the training notebook need NOTHING else here: the file carries its own
# class names, normalisation numbers and rejection data. Leave MODEL_ARCH as "auto".
# For a plain weights file of a standard network, set one of: resnet50, vgg16, densenet121, mobilenet_v2
MODEL_ARCH=auto

# The settings below are used only for standard networks (they are ignored for MS-CBAM-Net).
# Class names in the SAME ORDER used in training (ImageFolder sorts alphabetically).
CLASS_NAMES=glioma,meningioma,notumor,pituitary
IMAGE_SIZE=224
USE_AUTOCONTRAST=true
NORM_MEAN=0.485,0.456,0.406
NORM_STD=0.229,0.224,0.225

# Results below this confidence are flagged for manual review (0 to 1).
# MS-CBAM-Net uses the limit saved in its checkpoint instead.
CONFIDENCE_THRESHOLD=0.70

# Images that do not look like the training MRIs (distance check, 100% of 'other' images caught in the notebook):
REJECT_ON_DISTANCE=true
# Reject low-confidence images too? The notebook measured this check at 1.6% of 'other' images caught and
# 11% of real MRIs wrongly rejected, so it only flags a scan for manual review by default.
REJECT_ON_CONFIDENCE=false

# --- Login protection ---
# After this many wrong passwords for one email from one address, login is blocked for the window below.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Email (optional) ---
# Used for approval/rejection notices and password-reset links.
# Leave SMTP_HOST empty and the emails are printed in the terminal instead (fine for development).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# and SMTP_PASSWORD = a Google "app password" (not your normal password).
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NeuroScan AI <no-reply@neuroscan.local>
SMTP_TLS=true
# How long a password-reset link works (minutes).
RESET_TOKEN_MINUTES=30

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Browser origins allowed to call the API (comma separated) ---
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
